<Project Sdk="Microsoft.NET.Sdk">
  <!-- Comment stripper for packaging: parses each source with Roslyn and drops
       every comment trivia, so a // inside a string literal is never touched.
       Runs on any dotnet 8+ (RollForward) so the same binary logic serves the
       local pack script and the GitHub runner. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
  </ItemGroup>
</Project>
